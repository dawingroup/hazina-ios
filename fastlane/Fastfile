default_platform(:ios)

platform :ios do
  desc "Run unit tests"
  lane :test do
    sh("cd .. && xcodegen")
    run_tests(scheme: "Hazina", devices: ["iPhone 16"])
  end

  desc "Build and upload to TestFlight (needs App Store Connect API key in CI secrets)"
  lane :beta do
    sh("cd .. && xcodegen")
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
    )
    increment_build_number(build_number: ENV.fetch("GITHUB_RUN_NUMBER", "1"))
    build_app(scheme: "Hazina", export_method: "app-store")
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
